<?xml version="1.0" encoding="utf-8"?>
<!-- One notification card in the quick settings sheet: app icon in a circle, app name, title and text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/quick_card_bg"
    android:focusable="true"
    android:clickable="true">

    <FrameLayout
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/quick_icon_circle">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:tint="@drawable/pill_text"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        android:duplicateParentState="true">

        <TextView
            android:id="@+id/app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@drawable/quick_text_mid"
            android:duplicateParentState="true"
            android:textSize="10sp"
            android:fontFamily="@string/font_regular"
            android:textAlignment="viewStart"
            android:singleLine="true" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="13sp"
            android:fontFamily="@string/font_medium"
            android:textAlignment="viewStart"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@drawable/quick_text_mid"
            android:duplicateParentState="true"
            android:textSize="11sp"
            android:fontFamily="@string/font_regular"
            android:textAlignment="viewStart"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
